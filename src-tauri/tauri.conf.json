{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DubParty",
  "version": "0.1.0",
  "identifier": "com.dubparty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DubParty", "width": 1280, "height": 800, "minWidth": 760, "minHeight": 600, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 ws:; img-src 'self' data: asset:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": false, "targets": "all" }
}
